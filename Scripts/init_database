/*
=============================================================
Create Database and Schemas
=============================================================
Script Purpose:
    This script creates a new database named 'DataWarehouse'
    after checking if it already exists.

    MySQL does not have SQL Server-style schemas.
    In MySQL, a database is effectively used as a schema.

WARNING:
    Running this script will DROP the entire 'DataWarehouse'
    database if it already exists.
    All data will be permanently deleted.
=============================================================
*/

-- Drop database if it already exists
DROP DATABASE IF EXISTS DataWarehouse;

-- Create database
CREATE DATABASE DataWarehouse;

-- Select database
USE DataWarehouse;
show databases;
create schema Bronze;
create schema Silver;
create schema Gold;
